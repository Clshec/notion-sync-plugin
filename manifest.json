{
  "id": "alf-notion-super-productivity",
  "name": "Alf Notion Super Productivity",
  "version": "0.2.0",
  "manifestVersion": 1,
  "minSupVersion": "20.0.0",
  "description": "Notion-first Super Productivity integration: configurable, read-only Notion task preview (alpha)",
  "author": "Alf contributors; original Notion Sync Plugin by Alessio Lovato",
  "icon": "notion.svg",
  "iFrame": true,
  "sidePanel": true,
  "permissions": [
    "http",
    "getTasks",
    "getAllProjects",
    "persistDataSynced",
    "loadSyncedData",
    "setSecret",
    "getSecret",
    "deleteSecret",
    "showSnack",
    "showIndexHtmlAsView"
  ],
  "allowedHosts": [
    "api.notion.com"
  ],
  "dataSharing": [
    {
      "recipient": "Notion",
      "hosts": [
        "api.notion.com"
      ],
      "data": [
        "credentials",
        "ids"
      ]
    }
  ],
  "hooks": []
}
