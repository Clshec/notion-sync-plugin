{
  "id": "alf-notion-super-productivity",
  "name": "Alf Notion Super Productivity",
  "version": "0.40.5",
  "manifestVersion": 1,
  "minSupVersion": "20.0.0",
  "description": "One-token Notion-first automatic task/project sync with exact identity links, safe planning/time deltas and optional advanced diagnostics (experimental)",
  "author": "Alf contributors; original Notion Sync Plugin by Alessio Lovato",
  "icon": "notion.svg",
  "iFrame": true,
  "sidePanel": true,
  "permissions": [
    "http",
    "getTasks",
    "getAllProjects",
    "updateProject",
    "addProject",
    "persistDataSynced",
    "loadSyncedData",
    "setSecret",
    "getSecret",
    "deleteSecret",
    "showSnack",
    "showIndexHtmlAsView",
    "getArchivedTasks",
    "addTask",
    "updateTask",
    "listSyncedDataKeys",
    "getAppState",
    "getAllSimpleCounters",
    "setCounter"
  ],
  "allowedHosts": [
    "api.notion.com"
  ],
  "dataSharing": [
    {
      "recipient": "Notion",
      "hosts": [
        "api.notion.com"
      ],
      "data": [
        "credentials",
        "ids",
        "timeTracked"
      ]
    }
  ],
  "hooks": [
    "action",
    "currentTaskChange",
    "taskCreated",
    "taskComplete",
    "taskUpdate",
    "projectListUpdate"
  ]
}
