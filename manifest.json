{
  "id": "alf-notion-super-productivity",
  "name": "Alf Notion Super Productivity",
  "version": "0.11.0",
  "manifestVersion": 1,
  "minSupVersion": "20.0.0",
  "description": "Notion-first local task/focus/habit integration with reviewed Notion planning updates, opt-in work time, observed Pomodoro and habit writeback (experimental alpha)",
  "author": "Alf contributors; original Notion Sync Plugin by Alessio Lovato",
  "icon": "notion.svg",
  "iFrame": true,
  "sidePanel": true,
  "permissions": [
    "http",
    "getTasks",
    "getAllProjects",
    "persistDataSynced",
    "loadSyncedData",
    "setSecret",
    "getSecret",
    "deleteSecret",
    "showSnack",
    "showIndexHtmlAsView",
    "getArchivedTasks",
    "addTask",
    "updateTask",
    "listSyncedDataKeys",
    "getAppState"
  ],
  "allowedHosts": [
    "api.notion.com"
  ],
  "dataSharing": [
    {
      "recipient": "Notion",
      "hosts": [
        "api.notion.com"
      ],
      "data": [
        "credentials",
        "ids",
        "timeTracked"
      ]
    }
  ],
  "hooks": [
    "action",
    "currentTaskChange"
  ]
}
